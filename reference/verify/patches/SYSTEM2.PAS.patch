--- a/SYSTEM2.PAS
+++ b/SYSTEM2.PAS
@@ -11,6 +11,12 @@ UNIT System2;
 
 INTERFACE
 
+{ PATCH (fpc): matches PRIMINTR.PAS's own V-minus directive -- relaxes fpc's strict
+  fixed-string-length type matching (ScanTextFile's AllUpCase(Strg) call below passes a LineStr where
+  AllUpCase's own parameter is a differently-declared fixed string type; Turbo Pascal treated these as
+  interchangeable by content). }
+{$V-}
+
 USES Strg,DOS;
 
 CONST
@@ -151,13 +157,24 @@ PROCEDURE FillWord(VAR Dest; Count,Data: Word);
    NOTE: You cannot use SizeOf(..) as Count because that gives the number
    of BYTES.  Use SizeOf(..) DIV 2.
 ------------------------------------------------------------------------------ }
+   { PATCH (fpc): the original x86 INLINE assembly (real-mode ES:DI/CX/AX REP STOSW -- a word-granular
+     memset) has no fpc equivalent worth chasing; the perf reason for hand-written assembly here (a
+     TP4-era compiler with no optimizer) doesn't apply to a modern fpc/CPU, so a plain indexing loop
+     over the same memory is behaviorally identical and not a meaningful hot path in this harness
+     regardless. VAR Dest is an untyped parameter -- casting its address through a typed pointer is
+     standard Pascal, not the ABSOLUTE-overlay landmine noted elsewhere in this session (that one
+     relies on TWO separately-declared globals sharing memory by declaration order; this is a single
+     value reinterpreted through its own address, which fpc lays out no differently than TP did). }
+   TYPE
+      WordArray = ARRAY [0..65534] OF Word;
+      WordArrayPtr = ^WordArray;
+   VAR
+      Arr: WordArrayPtr;
+      i: Word;
    BEGIN
-   INLINE(
-      $C4/$BE/Dest/                       {  LES   DI,Dest[BP]  }
-      $8B/$8E/Count/                      {  MOV   CX,Count[BP] }
-      $8B/$86/Data/                       {  MOV   AX,Data[BP]  }
-      $FC/                                {  CLD                }
-      $F3/$AB);                           {  REP STOSW          }
+   Arr:=WordArrayPtr(@Dest);
+   FOR i:=0 TO Count-1 DO
+      Arr^[i]:=Data;
    END;  { FillWord }
 
 END.
