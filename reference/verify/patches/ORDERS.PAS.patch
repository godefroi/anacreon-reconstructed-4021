@@ -323,7 +330,15 @@ PROCEDURE SetFleetNextStatement(FltID: IDNumber; Com: Word);
 
 PROCEDURE GetFleetCode(FltID: IDNumber; VAR Code: OrderStructure);
    BEGIN
-   Code:=OrderStructure(Universe^.Fleet[FltID.Index]^.OrderData);
+   { PATCH (fpc): pristine code hard-cast OrderData (a 6-byte ARRAY[1..6] OF
+     Byte field) directly to OrderStructure (Word+MemoryArrayPtr, also 6 bytes
+     on this target) -- a raw byte-layout reinterpretation TP's looser
+     type-cast rules allowed but fpc's stricter type checker rejects
+     ("Illegal type conversion"). Move() does the same raw byte copy without
+     going through a type-cast; SetFleetCode already uses Move for the
+     reverse direction, so this mirrors an existing pattern in this same
+     file rather than introducing a new one. }
+   Move(Universe^.Fleet[FltID.Index]^.OrderData,Code,SizeOf(Code));
    END;  { GetFleetCode }
 
