+                     Nfgt,Nhkr,Njmp,Njtn,Npen,Nstr,Ntrn: Integer;
+                     Nmen,Nnnj,Namb,Nche,Nmet,Nsup,Ntri: Integer;
+                     NLAM,Ndef,NGDM,Nion: Integer;
