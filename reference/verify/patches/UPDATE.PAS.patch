+PROCEDURE SetUpWorld(WorldID: IDNumber;
+                     Cls: WorldClass;
+                     Tech: TechLevel;
+                     Typ: WorldTypes;
+                     Emp: Empire;
+                     Pop: Population;
+                     Eff: Index;
