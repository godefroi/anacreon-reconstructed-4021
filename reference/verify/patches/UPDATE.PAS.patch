+PROCEDURE CreateNPEmpire{VAR SF: TEXT; VAR EmpireName: EmpireNameArray};
+   VAR
+      i,E,Tl,NoOfTechs,RevFactor: Integer;
+      Emp: Empire;
+      Tech: TechLevel;
+      Name: String32;
+      BadToken: Boolean;
+      KnownTechs: TechnologySet;
+      Modifiers: SetOfEmpireModifiers;
+
+   BEGIN
+   E:=NextInteger(SF);
+   NextInteger(SF); { PATCH (fpc): NPEmpireTypes ordinal (ET) -- consumed to stay token-position-correct,
+                      not stored: it only ever fed the dropped InitializeNPE call below, and NPEmpireTypes
+                      itself lives in NPETypes.PAS, a unit this relocation deliberately doesn't import
+                      (see this block's own INTERFACE-section PATCH comment). }
+   Name:=DFA1NextToken(SF,BadToken);
+   RevFactor:=NextInteger(SF);
+   Tl:=NextInteger(SF);
+   Tech:=TechLevel(Tl);
+   NoOfTechs:=NextInteger(SF);
+   KnownTechs:=TechDev[Pred(Tech)];
+   FOR i:=1 TO NoOfTechs DO
+      KnownTechs:=KnownTechs+[TechnologyTypes(NextInteger(SF))];
+   KnownTechs:=KnownTechs * TechDev[Tech];
+
+   ReadModifierList(SF,Modifiers);
+
+   Emp:=Empire(E);
+
+   IF NOT EmpireActive(Emp) THEN
+      BEGIN
+      IF Name='RndName' THEN
+         GetRandomEmpireName(EmpireName,Name);
+
+      CreateEmpire(Emp,False,Boolean(Rnd(0,1)),Name,'',
+                   EmptyQuadrant,Tech,KnownTechs,RevFactor,Modifiers,Year);
+      { PATCH (fpc): InitializeNPE(Emp,ETyp) dropped -- see this relocation
+        block's own INTERFACE-section PATCH comment for why. }
+      END;
+   END;  { CreateNPEmpire }
