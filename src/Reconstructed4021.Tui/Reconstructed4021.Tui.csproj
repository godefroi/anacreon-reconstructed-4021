<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Reconstructed4021.Core\Reconstructed4021.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tried 2.4.18-develop.53 (upstream #5602/#5633, tracking tui-cs/Terminal.Gui#5323) for the
         Home/End tearing: confirmed by diffing both commits that neither touches the per-dirty-row
         Write() call in OutputBase.Write that causes it (#5602 is inline-mode-only; #5633 only
         helps sparse per-row diffs, not our mostly-dirty-row case). No measured improvement, so
         reverted to stable; see SingleFlushAnsiOutput for the workaround instead. -->
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />

    <!-- Terminal.Gui's own TextView is deprecated in this version with no replacement of its own,
         so this package (same tui-cs org, targets Terminal.Gui >= 2.4.17) supplies the multi-line
         text editor Close-Up's own Orders tab (CloseUpWindow) needs. Only runtime dependency besides Terminal.Gui itself is
         Microsoft.Extensions.Configuration.Abstractions; the AvaloniaEdit code it's adapted from is
         forked into its own third_party source, not a runtime dependency. -->
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />

    <!-- .NET's own options-loading pipeline for appsettings.json (TuiSettings): already resolved
         transitively at this version via Terminal.Gui.Editor's own Configuration.Abstractions
         dependency, pinned explicitly here since Load() calls into Json/Binder/FileExtensions directly. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="../assets/save/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
