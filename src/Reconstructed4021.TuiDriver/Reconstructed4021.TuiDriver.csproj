<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- A separate project, not a mode flag on Reconstructed4021.Tui2 itself, so a future Tui2 test
         project can reference this same driver without pulling in Program.cs's own interactive
         bootstrap (same precedent as Reconstructed4021.TuiDriver). -->
    <ProjectReference Include="..\Reconstructed4021.Tui2\Reconstructed4021.Tui2.csproj" />
    <!-- Tui2's own reference to this doesn't flow through to a compile-time reference here (same
         non-transitive behavior TuiDriver's own csproj comment documents), so this driver's own
         direct use of ScreenRunner/FrameBuffer needs its own reference. -->
    <ProjectReference Include="..\Reconstructed4021.Panemonde\Reconstructed4021.Panemonde.csproj" />
    <!-- The load-from-save-file option reads a save fixture directly (GameJson.Deserialize/
         LegacyNpeProvider), same non-transitive-reference reason as the two above. -->
    <ProjectReference Include="..\Reconstructed4021.Core\Reconstructed4021.Core.csproj" />
    <ProjectReference Include="..\Reconstructed4021.LegacyNpe\Reconstructed4021.LegacyNpe.csproj" />
  </ItemGroup>

</Project>
